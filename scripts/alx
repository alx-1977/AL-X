#!/usr/bin/env bash
# Start, stop, restart or inspect the AL/X live-voice runtime.
#
# The runtime is one process: `python -m alx.bootstrap.live_voice`, run from
# the repository root, serving on 127.0.0.1:8765. This script exists so a
# restart after a code or .env change is one command instead of a remembered
# sequence.
#
# It runs committed local `main`, never the working files. The Coding Agent
# edits this same checkout on a feature branch (D-033), so importing `src/`
# from it would let a failed edit leave AL/X unable to start, and so unable
# to recover the checkout. `main` is extracted with `git archive` into the git
# directory, where the Coding Agent cannot reach, without touching the branch,
# index or working tree.
#
#   scripts/alx restart     stop it, start it, wait until it answers
#   scripts/alx start
#   scripts/alx stop
#   scripts/alx status
#   scripts/alx log         follow the log
#
# Config comes from .env as it always has; this changes nothing about how the
# runtime is configured, only how it is launched.

set -uo pipefail

# This file's checkout; or, when running as committed main's text (below),
# the checkout it was started in.
if [ -f "${BASH_SOURCE[0]:-}" ]; then
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
else
  ROOT="$(git rev-parse --show-toplevel)" || exit 1
fi
cd "$ROOT" || exit 1

# The launcher that runs is committed main's, like the runtime it starts. Bash
# runs a script as it reads it, so this re-executes main's copy before the
# rest of this file is even parsed: a feature branch's edit below here cannot
# stop AL/X restarting, and takes effect once merged. If a branch breaks these
# lines themselves, the same thing needs only committed main:
#
#   bash <(git show main:scripts/alx) restart
#
# The script arrives on a file descriptor, never as an argument: its text
# names the runtime, so on a command line `pids` would mistake the launcher
# for the AL/X it is meant to stop.
if ! (return 0 2>/dev/null) && [ -z "${ALX_LAUNCHER_COMMITTED:-}" ]; then
  git cat-file -e refs/heads/main:scripts/alx 2>/dev/null \
    || { echo "no scripts/alx on local main" >&2; exit 1; }
  ALX_LAUNCHER_COMMITTED=1 exec bash <(git show refs/heads/main:scripts/alx) "$@"
fi

URL="http://127.0.0.1:8765"
LOG="$ROOT/.alx/runtime/live_voice.log"
CAPTURE="$ROOT/.alx/runtime/live_voice.process.log"
STAMP="$ROOT/.alx/runtime/live_voice.config"
PYTHON="${ALX_PYTHON:-python3}"
PATTERN="alx.bootstrap.live_voice"

# Only this checkout's runtime. `pgrep -f` alone matches the same module in
# any clone on the machine, so a restart here would kill a second checkout's
# process. Each candidate is kept only when its own working directory is this
# repository, which is the property that actually identifies it.
# macOS pgrep leaves out its own ancestors unless asked (-a). When AL/X
# restarts herself (D-055) this launcher is her descendant, so without -a it
# could not see her and reported "not running" (2026-10-17). Linux pgrep's -a
# means something else and never excludes ancestors, so it is macOS only.
PGREP_ANCESTORS=""
[ "$(uname -s)" = "Darwin" ] && PGREP_ANCESTORS="-a"

pids() {
  local candidate
  for candidate in $(pgrep $PGREP_ANCESTORS -f "$PATTERN" 2>/dev/null); do
    if [ "$(lsof -a -p "$candidate" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" = "$ROOT" ]; then
      printf '%s\n' "$candidate"
    fi
  done
}
healthy() { curl -fsS -o /dev/null --max-time 3 "$URL" 2>/dev/null; }

# A PID is not an identity: the OS reuses it, and a runtime started by hand
# could inherit the number of one this script recorded. Pairing it with the
# process creation time names one process rather than one slot.
started_at() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' '; }

stop() {
  local found; found="$(pids)"
  if [ -z "$found" ]; then
    echo "not running"
    return 0
  fi
  echo "stopping: $(echo "$found" | tr '\n' ' ')"
  # SIGTERM first so the runtime closes its stores cleanly; SIGKILL only if
  # it will not go, because a half-written SQLite goal store is worse than a
  # slow shutdown.
  kill $found 2>/dev/null
  for _ in $(seq 1 15); do
    [ -z "$(pids)" ] && { rm -f "$STAMP"; echo "stopped"; return 0; }
    sleep 1
  done
  echo "did not exit in 15s, forcing"
  kill -9 $(pids) 2>/dev/null
  sleep 1
  [ -z "$(pids)" ] && echo "stopped (forced)" || { echo "STILL RUNNING"; return 1; }
}

start() {
  if [ -n "$(pids)" ]; then
    echo "already running: $(pids | tr '\n' ' ')"
    return 1
  fi
  # Something already answering here is not this start's runtime. Starting
  # anyway, the new one cannot bind the port and dies, and the health check
  # below would read the old one's answer as "up" (2026-10-17).
  if healthy; then
    echo "something is already serving $URL; not starting a second runtime"
    return 1
  fi
  local code; code="$(runtime_code)" || return 1
  mkdir -p "$(dirname "$LOG")"
  # The collector owns the capture file and expires output even while idle.
  # Python owns the daily runtime log. The child keeps its PID and stdout/stderr
  # stay connected through maintenance rather than writing to a removed inode.
  # Keep startup/import failures and uncaught tracebacks across restarts too.
  rm -f "$STAMP"
  PYTHONPATH="$code/src" nohup "$PYTHON" -m "$PATTERN" --checkout "$ROOT" \
    > >(trap '' HUP; PYTHONPATH="$code/src" exec "$PYTHON" -m alx.observability.process_output "$CAPTURE") 2>&1 &
  local pid=$!
  echo "started pid $pid (main@$(basename "$code"))"
  record_config "$pid" "$code"
  for _ in $(seq 1 30); do
    sleep 1
    # The endpoint is shared, so a healthy answer alone proves only that
    # something is serving it. Our own child must still be alive, or a
    # start that died would report another checkout's runtime as this one.
    kill -0 "$pid" 2>/dev/null || break
    healthy && { echo "up at $URL"; show_config; return 0; }
  done
  # Nothing is running under this record, so it must not survive to be
  # reported as a live configuration.
  rm -f "$STAMP"
  echo "FAILED to come up. Last lines of process capture $CAPTURE and runtime log $LOG:"
  tail -15 "$CAPTURE"* "$LOG" 2>/dev/null
  return 1
}

# Extract committed local main and print where. Only git and tar run here:
# nothing from the checkout is imported, so a broken feature branch cannot
# stop this. One snapshot per commit, marked complete before it is renamed
# into place, so an installed snapshot is always whole and is never replaced.
# Nothing else is deleted: another AL/X process may still be running from an
# older snapshot, and only this process's own unfinished extraction is ours.
runtime_code() {
  local sha common base target staging
  sha="$(git -C "$ROOT" rev-parse --verify --quiet 'refs/heads/main^{commit}')" \
    || { echo "no local main commit to run" >&2; return 1; }
  common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)" \
    || return 1
  base="$common/alx-runtime"
  target="$base/$sha"
  if [ ! -e "$target" ]; then
    staging="$base/.staging-$$"
    rm -rf "$staging" && mkdir -p "$staging" || return 1
    if git -C "$ROOT" archive "$sha" src LAWS_OF_ALX.md IDENTITY_AND_MEMORY.md \
        | tar -x -C "$staging" && touch "$staging/.complete"; then
      # A concurrent start may have installed it first; then keep theirs.
      [ -e "$target" ] || mv "$staging" "$target" 2>/dev/null
    fi
    rm -rf "$staging" "$target/.staging-$$"
  fi
  [ -f "$target/.complete" ] \
    || { echo "could not extract main@$sha" >&2; return 1; }
  printf '%s\n' "$target"
}

show_config() {
  # Print what actually loaded, so a restart meant to pick up a config change
  # can be seen to have picked it up.
  # What the running process actually loaded, recorded by `start` against the
  # PID it launched. Re-reading .env here would report the file's current
  # contents rather than the configuration in effect, which is exactly the
  # confusion this script exists to remove: an edited .env would look live
  # before any restart.
  #
  # The record is shown only when it belongs to the PID running now. A stale
  # file - a start that failed, or a runtime someone launched by hand - would
  # otherwise be presented as that process's configuration.
  local running; running="$(pids | head -1)"
  if [ -n "$running" ] && [ -f "$STAMP" ] \
     && [ "$(head -1 "$STAMP")" = "pid=$running $(started_at "$running")" ]; then
    tail -n +2 "$STAMP"
  else
    echo "  coding: unknown (not started by this script)"
  fi
}

# Record the configuration this runtime loaded, against the PID that loaded it.
# Called by start once the process exists, so the record can never outlive or
# misattribute the process it describes.
record_config() {
  local pid="$1" code="$2"
  printf 'pid=%s %s\n' "$pid" "$(started_at "$pid")" >"$STAMP"
  printf '  code: main@%s\n' "$(basename "$code")" >>"$STAMP"
  PYTHONPATH="$code/src" "$PYTHON" - <<'PY' 2>/dev/null >>"$STAMP"
from pathlib import Path
from alx.bootstrap.live_voice import load_environment
from alx.config.settings import _coding_settings
env = load_environment(Path(".env"))
c = _coding_settings(env)
print(f"  coding: provider={c.reasoning.provider} model={c.reasoning.model} "
      f"plan_timeout={c.reasoning.timeout_seconds}s "
      f"session_stall={c.session_stall_seconds}s")
PY
}

status() {
  local found; found="$(pids)"
  if [ -z "$found" ]; then
    echo "stopped"
  else
    echo "running: $(echo "$found" | tr '\n' ' ')"
    ps -o pid,lstart,etime,%cpu -p $found | tail -n +2
  fi
  healthy && echo "health: OK ($URL)" || echo "health: not answering"
  local job; job="$(pgrep -f 'sandbox alx_coding_job' 2>/dev/null)"
  [ -n "$job" ] && echo "coding session IN PROGRESS: pid $job"
  [ -n "$found" ] && show_config
  return 0
}

stop_log_followers() {
  kill "${log_followers[@]}" ${log_sleeper:+"$log_sleeper"} 2>/dev/null
  wait
}

follow_log() {
  local capture known seen index
  # EXIT runs after function locals unwind; retain child PIDs for cleanup.
  log_followers=()
  log_sleeper=""
  local files=("$LOG")
  tail -F "$LOG" &
  log_followers[0]=$!
  trap 'stop_log_followers' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # Existing files retain tail's default last-ten-lines startup view.
  for capture in "$CAPTURE"*; do
    [ -f "$capture" ] || continue
    files+=("$capture")
    tail -F "$capture" &
    log_followers+=("$!")
  done
  while :; do
    for index in "${!files[@]}"; do
      # The runtime log stays followed even across deletion/rotation. Daily
      # captures are retired independently and their names become discoverable
      # again. Keep matching sparse indices in both Bash 3.2 indexed arrays.
      if [ "$index" != 0 ] && [ ! -f "${files[$index]}" ]; then
        kill "${log_followers[$index]}" 2>/dev/null
        wait "${log_followers[$index]}" 2>/dev/null
        unset 'files[index]' 'log_followers[index]'
        continue
      fi
      # A failed write (including a closed downstream pipe) exits tail. Stop
      # the entire session rather than leaving the other tails polling forever.
      kill -0 "${log_followers[$index]}" 2>/dev/null || break 2
    done
    # The collector creates a new name each UTC day. Re-expand the glob and
    # start each new follower from the beginning, including output written
    # before discovery. Arrays preserve spaces and shell metacharacters.
    for capture in "$CAPTURE"*; do
      [ -f "$capture" ] || continue
      seen=0
      for known in "${files[@]}"; do
        [ "$known" = "$capture" ] && { seen=1; break; }
      done
      [ "$seen" = 0 ] || continue
      files+=("$capture")
      tail -n +1 -F "$capture" &
      log_followers+=("$!")
    done
    # Waiting on a background sleep lets signals run cleanup immediately.
    sleep 1 &
    log_sleeper=$!
    wait "$log_sleeper"
    log_sleeper=""
  done
  stop_log_followers
  trap - EXIT INT TERM
  return 0
}

# Sourcing defines the functions without acting, so they can be tested.
if (return 0 2>/dev/null); then return 0; fi

case "${1:-restart}" in
  restart) stop; start ;;
  start)   start ;;
  stop)    stop ;;
  status)  status ;;
  log)     follow_log ;;
  *) echo "usage: scripts/alx {restart|start|stop|status|log}"; exit 2 ;;
esac
