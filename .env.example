# Provider selection. Model identifiers are deliberately configuration, not code.
# openai | xai | kimi. xai and kimi share one OpenAI-style
# /v1/chat/completions transport, so switching between them is a base URL, a
# key and a model name — never a code change or a second conversation path.
#   xai  : ALX_REASONING_BASE_URL=https://api.x.ai         model e.g. grok-4.5
#   kimi : ALX_REASONING_BASE_URL=https://api.moonshot.ai  model e.g. kimi-k3
ALX_REASONING_PROVIDER=openai
ALX_REASONING_MODEL=gpt-5.6-sol
ALX_REASONING_API_KEY=
ALX_REASONING_BASE_URL=https://api.openai.com
ALX_REASONING_TIMEOUT_SECONDS=120
ALX_REASONING_STREAMING=true
ALX_REASONING_SERVICE_TIER=priority
ALX_REASONING_EFFORT=medium

ALX_STT_PROVIDER=cartesia
ALX_STT_MODEL=ink-2
ALX_STT_API_KEY=
ALX_STT_BASE_URL=wss://api.cartesia.ai
ALX_STT_API_VERSION=2026-08-14
ALX_STT_ENCODING=pcm_s16le
ALX_STT_SAMPLE_RATE_HZ=16000
ALX_STT_TURN_START_THRESHOLD=0.7
ALX_STT_TURN_EAGER_END_THRESHOLD=0.5
ALX_STT_TURN_END_THRESHOLD=0.4
ALX_STT_TURN_END_TIMEOUT_MS=4500

ALX_TTS_PROVIDER=elevenlabs
ALX_TTS_MODEL=eleven_flash_v2_5
ALX_TTS_API_KEY=
ALX_TTS_VOICE_ID=
ALX_TTS_BASE_URL=https://api.elevenlabs.io
ALX_TTS_OUTPUT_FORMAT=mp3_44100_128
ALX_TTS_TIMEOUT_SECONDS=60
ALX_TTS_PRONUNCIATION_DICTIONARY_ID=
ALX_TTS_PRONUNCIATION_DICTIONARY_VERSION_ID=

# Local voice interface and durable runtime state.
ALX_INTERFACE_HOST=127.0.0.1
ALX_INTERFACE_PORT=8765
ALX_RUNTIME_STORAGE_ROOT=.alx/runtime
ALX_PRIMARY_PERSON_ID=friedl
ALX_GOAL_RETENTION_DAYS=3650
ALX_CORE_STEP_BUDGET=8

# Replying to mail (DECISIONS.md D-011). Every reply needs its own approval,
# bound to the exact wording and expiring after this window.
MAIL_SMTP_HOST=smtp.mail.me.com
MAIL_SMTP_PORT=587
ALX_MAIL_SEND_TIMEOUT_SECONDS=60
ALX_MAIL_APPROVAL_TTL_SECONDS=600

# Xero supplier bills (DECISIONS.md D-016). OAuth tokens are stored encrypted
# below ALX_RUNTIME_STORAGE_ROOT after running scripts/connect_xero.py.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://127.0.0.1:8000/xero/callback
XERO_TENANT_ID=
ALX_XERO_TIMEOUT_SECONDS=60
ALX_XERO_APPROVAL_TTL_SECONDS=600
ALX_XERO_UNATTENDED_BILL_WRITES=false
ALX_XERO_UNATTENDED_BILL_DELETES=false

# Where a supplier's own bills give no single answer, the expense account is a
# policy choice no invoice contains. Set these and such a bill posts to the
# default with its tax taken from the document; leave blank and AL/X asks.
ALX_XERO_DEFAULT_ACCOUNT_CODE=
ALX_XERO_DEFAULT_TAX_TYPE=

# DHL import treatment, carried over from V1. Import VAT is claimable, customs
# duty is not, and clearance is a service charge.
ALX_XERO_IMPORT_VAT_ACCOUNT=820
ALX_XERO_CUSTOMS_DUTY_ACCOUNT=426
ALX_XERO_CLEARANCE_ACCOUNT=425
# The DHL supplier's exact name in Xero. The contact is resolved from this at
# run time, so no Xero identifier has to be found by hand. V1 used this default.
ALX_XERO_DHL_SUPPLIER_NAME=DHL International (Pty) Ltd

# Bounded specialist questions such as invoice extraction. Configured
# independently of the Core so tuning one never disturbs the other; blank
# values inherit the Core provider, model and credential.
ALX_SPECIALIST_PROVIDER=
ALX_SPECIALIST_MODEL=
# Honoured on OpenAI only; the xAI transport accepts no effort parameter.
ALX_SPECIALIST_EFFORT=none
ALX_SPECIALIST_TIMEOUT_SECONDS=60
ALX_MAIL_PROCESSED_MAILBOX=

# --- Research cognition tiers -------------------------------------------
# Tiers are cognitive difficulty, not subject matter and not vendors. Each
# defaults to the specialist configuration, so only what differs is set here.
# ALX_RESEARCH_SURVEY_PROVIDER=
# ALX_RESEARCH_SURVEY_MODEL=
# ALX_RESEARCH_COMPARE_PROVIDER=
# ALX_RESEARCH_COMPARE_MODEL=
# ALX_RESEARCH_JUDGE_PROVIDER=
# ALX_RESEARCH_JUDGE_MODEL=

# Which tiers may actually run. Empty disables paid research entirely; a tier
# that is not named here is never built, so it cannot be selected. Price is not
# a permission: every configured model fits the ceiling, so this list is what
# restricts the first live test to SURVEY.
# ALX_RESEARCH_ENABLED_TIERS=survey

# Hard ceiling on autonomous research spend. A request reserves the per-request
# maximum before it runs, so the day cannot be overspent by a final expensive
# call. Exhaustion stops research; it never downgrades a tier or changes
# provider. Both default to 0, which disables paid autonomous research.
# RESEARCH_DAILY_BUDGET_USD=0
# RESEARCH_PER_REQUEST_MAX_USD=0
