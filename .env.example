# AL/X runtime configuration template. Copy to .env (git-ignored) and fill
# credentials there. Provider and model choices are configuration, not Core
# behaviour. Empty optional keys use the documented defaults in code.

# === Core / reasoning ===
# openai | xai | kimi | claude_subscription | grok_subscription
# xai and kimi share one OpenAI-style /v1/chat/completions transport.
#   xai  : ALX_REASONING_BASE_URL=https://api.x.ai         model e.g. grok-4.5
#   kimi : ALX_REASONING_BASE_URL=https://api.moonshot.ai  model e.g. kimi-k3
#   claude_subscription : Claude Code CLI. No API key. Set ALX_REASONING_MODEL
#     and leave ALX_REASONING_API_KEY unset. Requires `claude` on PATH.
#     Specialist then defaults to none. Supplier-invoice capture uses
#     LlamaParse, not the specialist.
ALX_REASONING_PROVIDER=openai
ALX_REASONING_MODEL=gpt-5.6-sol
ALX_REASONING_API_KEY=
ALX_REASONING_BASE_URL=https://api.openai.com
ALX_REASONING_TIMEOUT_SECONDS=120
ALX_REASONING_STREAMING=true
ALX_REASONING_SERVICE_TIER=priority
ALX_REASONING_EFFORT=medium

ALX_INTERFACE_HOST=127.0.0.1
ALX_INTERFACE_PORT=8765
ALX_RUNTIME_STORAGE_ROOT=.alx/runtime
ALX_PRIMARY_PERSON_ID=friedl
ALX_GOAL_RETENTION_DAYS=3650
ALX_CORE_STEP_BUDGET=8

# Bounded specialist questions. Independent of the Core. Blank provider
# inherits the Core; `none` leaves specialist capabilities unadvertised.
# capture_supplier_invoice does not use this.
ALX_SPECIALIST_PROVIDER=
ALX_SPECIALIST_MODEL=
ALX_SPECIALIST_API_KEY=
# Honoured on OpenAI only; the xAI transport accepts no effort parameter.
ALX_SPECIALIST_EFFORT=none
ALX_SPECIALIST_TIMEOUT_SECONDS=60

# === Coding Agent / reviewers ===
# D-028. Off by default. Independent of the conversational Core. The default
# coding backend is the Grok CLI subscription (`grok` on PATH), not the xAI
# HTTP API. Does not merge, push, deploy, or request a review.
ALX_CODING_ENABLED=false
ALX_CODING_PROVIDER=grok_subscription
ALX_CODING_MODEL=grok-4.6
ALX_CODING_TIMEOUT_SECONDS=120
ALX_CODING_SESSION_TIMEOUT_SECONDS=1200
ALX_CODING_EFFORT=medium
ALX_CODING_REVIEWER_PROVIDER=codex_subscription
ALX_CODING_REVIEWER_MODEL=gpt-5.6-luna
ALX_CODING_REVIEWER_EFFORT=high

# GitHub token shared by merge and review-request. Both stay unregistered
# without it. Needs repository contents and pull-request write access.
GITHUB_TOKEN=
# D-026. Off by default.
ALX_MERGE_ENABLED=false
ALX_MERGE_REPOSITORY=alx-1977/AL-X
ALX_REVIEW_REQUEST_ENABLED=false

# Isolated experimentation (D-027). Off by default. Separate from
# ALX_RUNTIME_STORAGE_ROOT.
ALX_SANDBOX_ENABLED=false
ALX_SANDBOX_ROOT=
ALX_SANDBOX_DAILY_RUNS=20
ALX_SANDBOX_DAILY_WALL_SECONDS=300

# === Mail / iCloud ===
MAIL_ADDRESS=
MAIL_KEY=
MAIL_IMAP_HOST=imap.mail.me.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.mail.me.com
MAIL_SMTP_PORT=587
ALX_MAIL_POLL_SECONDS=15
ALX_MAIL_SEND_TIMEOUT_SECONDS=60
ALX_MAIL_APPROVAL_TTL_SECONDS=600
ALX_MAIL_PROCESSED_MAILBOX=

# === Xero / DHL ===
# OAuth tokens are stored encrypted under ALX_RUNTIME_STORAGE_ROOT after
# scripts/connect_xero.py.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://127.0.0.1:8000/xero/callback
XERO_TENANT_ID=
ALX_XERO_TIMEOUT_SECONDS=60
ALX_XERO_APPROVAL_TTL_SECONDS=600
ALX_XERO_UNATTENDED_BILL_WRITES=false
ALX_XERO_UNATTENDED_BILL_DELETES=false
# Where a supplier's own bills give no single answer. Blank: AL/X asks.
ALX_XERO_DEFAULT_ACCOUNT_CODE=
ALX_XERO_DEFAULT_TAX_TYPE=
# DHL treatment. Import VAT is claimable, duty is not, clearance is a service.
ALX_XERO_IMPORT_VAT_ACCOUNT=820
ALX_XERO_CUSTOMS_DUTY_ACCOUNT=426
ALX_XERO_CLEARANCE_ACCOUNT=425
ALX_XERO_DHL_SUPPLIER_NAME=DHL International (Pty) Ltd

# === LlamaCloud / document extraction ===
# Canonical credential for capture_supplier_invoice. Independent of Core and
# of ALX_SPECIALIST_*. Empty key leaves capture unadvertised; there is no
# fallback to the reasoning model or the generic specialist.
ALX_LLAMAPARSE_API_KEY=
# Compatibility alias for the same credential. Canonical name wins if both set.
# LLAMA_CLOUD_API_KEY=
# Optional. Defaults are applied when unset.
ALX_LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai
ALX_LLAMAPARSE_TIMEOUT_SECONDS=60
# Optional Extract v2 project_id query parameter.
ALX_LLAMAPARSE_PROJECT_ID=

# === Voice / STT / TTS ===
ALX_STT_PROVIDER=cartesia
ALX_STT_MODEL=ink-2
ALX_STT_API_KEY=
# Compatibility alias: CARTESIA_API_KEY
ALX_STT_BASE_URL=wss://api.cartesia.ai
ALX_STT_API_VERSION=2026-08-14
ALX_STT_ENCODING=pcm_s16le
ALX_STT_SAMPLE_RATE_HZ=16000
ALX_STT_TURN_START_THRESHOLD=0.7
ALX_STT_TURN_EAGER_END_THRESHOLD=0.5
ALX_STT_TURN_END_THRESHOLD=0.4
ALX_STT_TURN_END_TIMEOUT_MS=4500

ALX_TTS_PROVIDER=elevenlabs
ALX_TTS_MODEL=eleven_flash_v2_5
ALX_TTS_API_KEY=
ALX_TTS_VOICE_ID=
# Compatibility aliases: ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID
ALX_TTS_BASE_URL=https://api.elevenlabs.io
ALX_TTS_OUTPUT_FORMAT=mp3_44100_128
ALX_TTS_TIMEOUT_SECONDS=60
ALX_TTS_SPEED=1.0
ALX_TTS_STABILITY=0.5
ALX_TTS_SIMILARITY_BOOST=0.75
ALX_TTS_SPEAKER_BOOST=true
ALX_TTS_PRONUNCIATION_DICTIONARY_ID=
ALX_TTS_PRONUNCIATION_DICTIONARY_VERSION_ID=

# === Web / research ===
# D-025 public URL reading. Off until authorised.
ALX_WEB_READ_ENABLED=false
# D-025 paid search. Separate from reading.
ALX_WEB_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_USD_PER_REQUEST=0.005
BRAVE_SEARCH_DAILY_REQUESTS=0
BRAVE_SEARCH_DAILY_USD=0

# Research cognition tiers. Empty ENABLED_TIERS disables paid research.
# Tiers are cognitive difficulty, not vendors.
ALX_RESEARCH_ENABLED_TIERS=
ALX_RESEARCH_SURVEY_PROVIDER=
ALX_RESEARCH_SURVEY_MODEL=
ALX_RESEARCH_COMPARE_PROVIDER=
ALX_RESEARCH_COMPARE_MODEL=
ALX_RESEARCH_JUDGE_PROVIDER=
ALX_RESEARCH_JUDGE_MODEL=
RESEARCH_DAILY_BUDGET_USD=0
RESEARCH_PER_REQUEST_MAX_USD=0

# Autonomous cognition (D-024). Unset provider disables the experiment.
# AUTONOMOUS_COGNITION_DAILY_BUDGET_USD=0
# ALX_AUTONOMOUS_PROVIDER=
# ALX_AUTONOMOUS_MODEL=
# ALX_AUTONOMOUS_EFFORT=max

# === Electronics / supplier integrations ===
# Planned. Current main does not wire these yet. Keep credentials in .env so
# the integrations can be enabled without rediscovering them. Empty here.
# DigiKey
DIGIKEY_REDIRECT_URI=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_APP=
DIGIKEY_ENV=
DIGIKEY_AI_ASSIST=
DIGIKEY_REFRESH_TOKEN=
# JLC
JLC_BACKEND=
JLC_ALLOW_FALLBACK=
JLC_APP_ID=
JLC_ACCESS_KEY=
JLC_SECRET_KEY=
JLC_PUBLIC_TOKENIZED_KEY=
JLC_PRIVATE_TOKENIZED_KEY=
# Nexar
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
NEXAR_ACCESS_TOKEN=
NEXAR_EVAL_CLIENT_ID=
NEXAR_EVAL_CLIENT_SECRET=
NEXAR_EVAL_ACCESS_TOKEN=
# Particle
PARTICLE_ACCESS_TOKEN=
# Greptile
GREPTILE_TOKEN=
